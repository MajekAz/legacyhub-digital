    "test:routes": "node scripts/check-routes.mjs",
    "build:sites": "vinext build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.6",
